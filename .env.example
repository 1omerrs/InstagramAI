# Meta webhook doğrulaması. developers.facebook.com içinde aynı değeri yazacaksın.
VERIFY_TOKEN=degistir-bunu

# Meta uygulama sırrı. Doluysa gelen webhook imzası doğrulanır.
META_APP_SECRET=

# Instagram User access token ve profesyonel hesap kimliği.
# Hesap bağlanınca doldurulur. Boşken yanıt üretilir ama Instagram'a gitmez.
IG_ACCESS_TOKEN=
IG_USER_ID=
GRAPH_API_VERSION=v25.0
GRAPH_BASE_URL=https://graph.instagram.com

# Doluysa Meta webhook'u temiz mesajı n8n'e iletir.
# Boşsa Python hem yanıtı üretir hem göndermeyi dener.
N8N_WEBHOOK_URL=

# OpenAI anahtarı sk- ile başlar. Değeri buraya yapıştır.
# Anahtar boşken servis test yanıtı döner.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

DATABASE_PATH=data/conversations.db
HISTORY_LIMIT=10
